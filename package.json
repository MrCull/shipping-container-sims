{
  "name": "shipping-container-sims",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:smoke": "vite build --mode smoke --outDir .smoke-build --emptyOutDir",
    "capture-readme-media": "node scripts/capture-readme-media.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "pnpm run verify:checks && node scripts/unit-select.mjs --run",
    "verify:all": "pnpm run verify:checks && pnpm test",
    "verify:checks": "node scripts/check-deps.mjs && node scripts/check-tracked-files.mjs && node scripts/check-no-em-dash.mjs && node scripts/check-no-hex-colours.mjs && node scripts/check-md-line-length.mjs && node scripts/check-commit-trailers.mjs && node scripts/check-no-quarantine.mjs && node scripts/check-doc-engine-version.mjs && node scripts/check-smoke-groups.mjs && node --test scripts/test-check-md-line-length.mjs scripts/test-check-no-hex-colours.mjs scripts/test-check-smoke-groups.mjs scripts/test-smoke-select.mjs scripts/test-smoke-shards.mjs scripts/test-smoke-ci.mjs scripts/test-check-doc-engine-version.mjs scripts/test-peak-day-check.mjs scripts/test-tickets-from-sub-issues.mjs scripts/test-fetch-issues.mjs scripts/test-smoke-budget.mjs scripts/test-smoke-summary-reporter.mjs scripts/test-smoke-merge.mjs scripts/test-vitest-projects.mjs scripts/test-unit-select.mjs && pnpm run lint && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sim": "node scripts/test-sim.mjs",
    "test:related": "bash scripts/test-related.sh",
    "tt:card": "node scripts/tt-home-card.mjs",
    "ys:solve": "tsx src/sims/yardshift/cli/solve.ts",
    "tt:run": "tsx src/sims/terminal-twin/cli/run.ts",
    "tt:fixtures": "tsx src/sims/terminal-twin/cli/build-fixtures.ts",
    "tt:bench": "tsx src/sims/terminal-twin/cli/bench.ts",
    "tt:frame-report": "tsx src/sims/terminal-twin/cli/frameReport.ts",
    "tt:baseline": "tsx src/sims/terminal-twin/cli/baselineCli.ts",
    "tt:diff": "tsx src/sims/terminal-twin/cli/diff.ts",
    "tt:experiment": "tsx src/sims/terminal-twin/cli/experimentRun.ts",
    "tt:sts": "tsx src/sims/terminal-twin/cli/sts.ts",
    "tt:plan": "tsx src/sims/terminal-twin/cli/plan.ts",
    "tt:profile": "tsx src/sims/terminal-twin/cli/profile.ts",
    "tt:golden": "tsx src/sims/terminal-twin/cli/golden-cli.ts",
    "test:smoke": "playwright test",
    "tt:assets": "tsx src/sims/terminal-twin/cli/assets/build.ts",
    "tt:assets:check": "tsx src/sims/terminal-twin/cli/assets/check.ts",
    "tt:sounds": "tsx src/sims/terminal-twin/cli/sounds/build.ts",
    "tt:sounds:check": "tsx src/sims/terminal-twin/cli/sounds/build.ts --check",
    "tt:assets:shots": "tsx src/sims/terminal-twin/cli/assets/screenshots.ts"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "pinia": "^4.0",
    "three": "^0.186",
    "vue": "^3.5",
    "vue-router": "^5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186",
    "@vitejs/plugin-vue": "^6.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "happy-dom": "^21.0.4",
    "meshoptimizer": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
