{
  "name": "shipping-container-sims",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "capture-readme-media": "node scripts/capture-readme-media.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run lint && npm run build && npm test --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "tt:run": "tsx src/sims/terminal-twin/cli/run.ts",
    "tt:fixtures": "tsx src/sims/terminal-twin/cli/build-fixtures.ts",
    "tt:diff": "tsx src/sims/terminal-twin/cli/diff.ts",
    "tt:golden": "tsx src/sims/terminal-twin/cli/golden-cli.ts",
    "test:smoke": "playwright test",
    "tt:assets": "tsx src/sims/terminal-twin/cli/assets/build.ts",
    "tt:assets:check": "tsx src/sims/terminal-twin/cli/assets/check.ts",
    "tt:assets:shots": "tsx src/sims/terminal-twin/cli/assets/screenshots.ts"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "pinia": "^4.0",
    "three": "^0.186",
    "vue": "^3.5",
    "vue-router": "^5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186",
    "@vitejs/plugin-vue": "^6.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "meshoptimizer": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3"
  }
}
